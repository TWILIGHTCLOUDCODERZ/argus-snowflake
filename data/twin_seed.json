  "clauses": [
    {
      "clause_id": "CL-01",
      "regulation_id": "REG-CBUAE-AML-2024",
      "article_ref": "Art. 15",
      "text": "Detect and report multiple cash deposits below the AED 55,000 CTR threshold indicating intent to evade reporting."
    },
    {
      "clause_id": "CL-02",
      "regulation_id": "REG-CBUAE-AML-2024",
      "article_ref": "Art. 22",
      "text": "Reuse of the same identity, device, or contact to open accounts across institutions is a synthetic-identity red flag."
    },
    {
      "clause_id": "CL-03",
      "regulation_id": "REG-FATF-R16",
      "article_ref": "Sec. 16.4",
      "text": "Monitor layering and circular flows that move through a chain of institutions and return near origin."
    },
    {
      "clause_id": "CL-04",
      "regulation_id": "REG-CBUAE-AML-2024",
      "article_ref": "Art. 31",
      "text": "Monitor money mule networks: rapid pass-through, fan-in/fan-out structures, consolidation of many inflows."
    },
    {
      "clause_id": "CL-05",
      "regulation_id": "REG-SAMA-AML-2023",
      "article_ref": "Art. 8",
      "text": "Identify money mule and pass-through accounts receiving funds from multiple parties or institutions; single-bank monitoring is not sufficient."
    },
    {
      "clause_id": "CL-06",
      "regulation_id": "REG-SAMA-AML-2023",
      "article_ref": "Art. 12",
      "text": "Detect series of cash deposits structured below the cash transaction reporting threshold and report to GDFI."
    },
    {
      "clause_id": "CL-07",
      "regulation_id": "REG-SAMA-AML-2023",
      "article_ref": "Art. 17",
      "text": "Determine whether a suspicious identifier is associated with customers at other institutions using privacy-preserving mechanisms."
    },
    {
      "clause_id": "CL-08",
      "regulation_id": "REG-CBB-FC-2024",
      "article_ref": "FC-1.5",
      "text": "Detect the same identity document or device used at more than one licensee; own-customer checks do not satisfy this."
    },
    {
      "clause_id": "CL-09",
      "regulation_id": "REG-CBB-FC-2024",
      "article_ref": "FC-4.2",
      "text": "Enhanced monitoring of GCC cross-border corridor transfers, chains across institutions and flows returning near origin."
    },
    {
      "clause_id": "CL-10",
      "regulation_id": "REG-CBB-FC-2024",
      "article_ref": "FC-6.1",
      "text": "File an STR with the Financial Intelligence Directorate within three business days of forming suspicion."
    }
  ],
